# Copier ce fichier en ".env" puis remplir les valeurs. Ne JAMAIS pousser ".env" sur GitHub.

# --- Base de données -------------------------------------------------------------
DB_NAME=boutique_cosmetique
DB_USER=boutique
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Développement local SANS Docker seulement (Docker impose DB_HOST=db) :
DB_HOST=localhost
DB_PORT=3306

# --- Sécurité --------------------------------------------------------------------
# 32 caractères minimum. Générer avec :  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION=2h

# --- Réseau ----------------------------------------------------------------------
PORT=3000
# Adresse du frontend autorisée à appeler l'API (CORS)
#   développement : http://localhost:5173      production : https://votre-domaine.com
FRONTEND_URL=http://localhost:5173
# Production (Docker + Caddy) : nom de domaine pointant vers le serveur
DOMAINE=localhost

# --- Règles de la boutique --------------------------------------------------------
TAUX_TAXE=0.13
FRAIS_LIVRAISON=8
# Livraison gratuite à partir de ce sous-total (0 = jamais)
LIVRAISON_GRATUITE_DES=0
# Minutes pendant lesquelles les quantités restent réservées pendant un paiement
PAIEMENT_EXPIRATION_MINUTES=15
